# SentinelAI live-daemon environment - example only, every value is a placeholder.
#
# Install as /etc/sentinelai/sentinelai.env, owned by root, mode 0600:
#   sudo install -o root -g root -m 0600 deploy/sentinelai.env.example /etc/sentinelai/sentinelai.env
# systemd reads EnvironmentFile as root before dropping privileges, so the
# unprivileged service user does not need read access to this file.
# NEVER commit the real file to git. Plain KEY=value lines, no quotes needed.
#
# This file is loaded by sentinelai.service (the always-on log-parsing daemon).
# It holds ONLY threat-intel keys and generic settings. Notification secrets
# (Telegram/Slack/email) go in sentinelai-digest.env instead - see
# sentinelai-digest.env.example.

# Threat intelligence (AbuseIPDB)
# SENTINELAI_INTEL_ABUSEIPDB_ENABLED=true
# SENTINELAI_INTEL_ABUSEIPDB_API_KEY=CHANGE_ME
