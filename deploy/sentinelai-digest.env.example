# SentinelAI digest environment - example only, every value is a placeholder.
#
# Install as /etc/sentinelai/sentinelai-digest.env, owned by root, mode 0600:
#   sudo install -o root -g root -m 0600 deploy/sentinelai-digest.env.example /etc/sentinelai/sentinelai-digest.env
# systemd reads EnvironmentFile as root before dropping privileges, so the
# unprivileged service user does not need read access to this file.
# NEVER commit the real file to git. Plain KEY=value lines, no quotes needed.
#
# This file is loaded ONLY by sentinelai-digest.service (the short-lived
# oneshot run by the timer). Keep it separate from sentinelai.env so the
# always-on log-parsing daemon never holds notification secrets.

# Notifications used by `sentinel digest --send`
# SENTINELAI_NOTIFY_TELEGRAM_TOKEN=CHANGE_ME
# SENTINELAI_NOTIFY_SLACK_WEBHOOK=CHANGE_ME
# SENTINELAI_NOTIFY_EMAIL_PASSWORD=CHANGE_ME
